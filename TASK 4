
#include <stdio.h>

int main(void) {
    int a[] = {7, 2, 9, 4, 3, 8, 5};
    int n = 7;
    int pivot = a[n - 1];
    int i = -1;
    int swaps = 0;

    printf("Initial array: ");
    for (int k = 0; k < n; k++)
        printf("%d ", a[k]);
    printf("\n");

    for (int j = 0; j < n - 1; j++) {
        if (a[j] <= pivot) {
            i++;
            int t = a[i];
            a[i] = a[j];
            a[j] = t;
            swaps++;

            printf("After swap: ");
            for (int k = 0; k < n; k++)
                printf("%d ", a[k]);
            printf("\n");
        }
    }

    int t = a[i + 1];
    a[i + 1] = a[n - 1];
    a[n - 1] = t;

    printf("After pivot swap: ");
    for (int k = 0; k < n; k++)
        printf("%d ", a[k]);

    printf("\nPivot at index: %d\n", i + 1);
    printf("Loop swaps: %d\n", swaps);
    printf("Comparisons: %d\n", n - 1);

    return 0;
}





#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define N 10000

long long comparisons;
int maxDepth;

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

int partition(int a[], int low, int high) {
    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        comparisons++;
        if (a[j] <= pivot) {
            i++;
            swap(&a[i], &a[j]);
        }
    }

    swap(&a[i + 1], &a[high]);
    return i + 1;
}

void quickSort(int a[], int low, int high, int depth) {
    if (low < high) {
        if (depth > maxDepth)
            maxDepth = depth;

        int p = partition(a, low, high);
        quickSort(a, low, p - 1, depth + 1);
        quickSort(a, p + 1, high, depth + 1);
    }
}

void test(char *label, int type) {
    int *a = malloc(N * sizeof(int));
    if (a == NULL) {
        printf("Memory allocation failed\n");
        return;
    }

    for (int i = 0; i < N; i++) {
        if (type == 0)
            a[i] = rand() % 100000;
        else if (type == 1)
            a[i] = i;
        else
            a[i] = N - i;
    }

    comparisons = 0;
    maxDepth = 0;

    quickSort(a, 0, N - 1, 1);

    printf("%s\n", label);
    printf("Comparisons: %lld\n", comparisons);
    printf("Maximum recursion depth: %d\n\n", maxDepth);

    free(a);
}

int main(void) {
    srand(1);

    test("Random data:", 0);
    test("Sorted data:", 1);
    test("Reverse sorted data:", 2);

    return 0;
}
