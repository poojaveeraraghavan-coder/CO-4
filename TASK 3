
#include <stdio.h>

#define MAX 32

typedef struct {
    int severity;
    int patient;
} Case;

Case heap[MAX];
int size = 0;

void swap(Case *a, Case *b)
{
    Case t = *a;
    *a = *b;
    *b = t;
}

void push(int severity, int patient)
{
    if (size == MAX)
        return;

    heap[size] = (Case){severity, patient};

    int i = size++;

    /* TODO 1: Sift up */
    while (i > 0)
    {
        int parent = (i - 1) / 2;

        if (heap[parent].severity >= heap[i].severity)
            break;

        swap(&heap[parent], &heap[i]);
        i = parent;
    }
}

Case pop(void)
{
    Case top = heap[0];

    heap[0] = heap[--size];

    int i = 0;

    /* TODO 2: Sift down */
    while (1)
    {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int largest = i;

        if (left < size &&
            heap[left].severity > heap[largest].severity)
            largest = left;

        if (right < size &&
            heap[right].severity > heap[largest].severity)
            largest = right;

        if (largest == i)
            break;

        swap(&heap[i], &heap[largest]);
        i = largest;
    }

    return top;
}

int main(void)
{
    push(3, 101);
    push(9, 102);
    push(5, 103);
    push(7, 104);
    push(1, 105);
    push(8, 106);

    printf("Patient treatment order:\n");

    while (size > 0)
    {
        Case p = pop();
        printf("P%d(%d) ", p.patient, p.severity);
    }

    printf("\n");

    return 0;
}
