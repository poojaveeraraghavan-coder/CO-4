
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_ORDERS 100000
#define TABLE_SIZE 131071

typedef struct {
    int id;
    char restaurant[30];
    int amount;
    int arrivalTime;
    int cancelled;
    int assigned;
} Order;

typedef struct {
    int orderIndex;
    int arrivalTime;
} HeapNode;

Order orders[MAX_ORDERS];
int orderCount = 0;

int hashTable[TABLE_SIZE];
HeapNode heap[MAX_ORDERS];
int heapSize = 0;

int hash(int id) {
    return id % TABLE_SIZE;
}

void insertHash(int id, int index) {
    int pos = hash(id);

    while (hashTable[pos] != -1)
        pos = (pos + 1) % TABLE_SIZE;

    hashTable[pos] = index;
}

int searchOrder(int id) {
    int pos = hash(id);
    int start = pos;

    while (hashTable[pos] != -1) {
        int index = hashTable[pos];

        if (orders[index].id == id)
            return index;

        pos = (pos + 1) % TABLE_SIZE;

        if (pos == start)
            break;
    }

    return -1;
}

void heapSwap(HeapNode *a, HeapNode *b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

void heapPush(int index) {
    int i = heapSize++;

    heap[i].orderIndex = index;
    heap[i].arrivalTime = orders[index].arrivalTime;

    while (i > 0) {
        int parent = (i - 1) / 2;

        if (heap[parent].arrivalTime <= heap[i].arrivalTime)
            break;

        heapSwap(&heap[parent], &heap[i]);
        i = parent;
    }
}

int heapPop(void) {
    int result = heap[0].orderIndex;

    heap[0] = heap[--heapSize];

    int i = 0;

    while (1) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = i;

        if (left < heapSize &&
            heap[left].arrivalTime < heap[smallest].arrivalTime)
            smallest = left;

        if (right < heapSize &&
            heap[right].arrivalTime < heap[smallest].arrivalTime)
            smallest = right;

        if (smallest == i)
            break;

        heapSwap(&heap[i], &heap[smallest]);
        i = smallest;
    }

    return result;
}

void placeOrder(int id, const char *restaurant,
                int amount, int arrivalTime) {

    if (orderCount >= MAX_ORDERS)
        return;

    int index = orderCount++;

    orders[index].id = id;
    strcpy(orders[index].restaurant, restaurant);
    orders[index].amount = amount;
    orders[index].arrivalTime = arrivalTime;
    orders[index].cancelled = 0;
    orders[index].assigned = 0;

    insertHash(id, index);
    heapPush(index);
}

void cancelOrder(int id) {
    int index = searchOrder(id);

    if (index == -1) {
        printf("Order %d not found.\n", id);
    } else if (orders[index].assigned) {
        printf("Order %d already assigned.\n", id);
    } else {
        orders[index].cancelled = 1;
        printf("Order %d cancelled.\n", id);
    }
}

void assignOrder(void) {
    while (heapSize > 0) {
        int index = heapPop();

        if (orders[index].cancelled || orders[index].assigned)
            continue;

        orders[index].assigned = 1;

        printf("Assigned Order %d from %s to rider.\n",
               orders[index].id,
               orders[index].restaurant);
        return;
    }

    printf("No available orders.\n");
}

int compareOrders(const void *a, const void *b) {
    const Order *x = (const Order *)a;
    const Order *y = (const Order *)b;

    int result = strcmp(x->restaurant, y->restaurant);

    if (result != 0)
        return result;

    if (x->amount < y->amount) return -1;
    if (x->amount > y->amount) return 1;
    return 0;
}

void generateReport(void) {
    Order report[MAX_ORDERS];
    int count = 0;

    for (int i = 0; i < orderCount; i++) {
        if (!orders[i].cancelled)
            report[count++] = orders[i];
    }

    qsort(report, count, sizeof(Order), compareOrders);

    printf("\n--- ORDER REPORT ---\n");

    for (int i = 0; i < count; i++) {
        printf("ID: %d | Restaurant: %s | Amount: %d\n",
               report[i].id,
               report[i].restaurant,
               report[i].amount);
    }
}

int main(void) {
    for (int i = 0; i < TABLE_SIZE; i++)
        hashTable[i] = -1;

    printf("FOOD DELIVERY ORDER MANAGEMENT SYSTEM\n\n");

    placeOrder(101, "PizzaHub", 350, 10);
    placeOrder(102, "BurgerTown", 250, 5);
    placeOrder(103, "PizzaHub", 450, 15);
    placeOrder(104, "FoodCorner", 200, 8);
    placeOrder(105, "BurgerTown", 300, 12);

    printf("Five orders placed successfully.\n");

    int index = searchOrder(103);

    if (index != -1)
        printf("Order 103 found: %s, Amount: %d\n",
               orders[index].restaurant,
               orders[index].amount);

    cancelOrder(104);

    printf("\nRider Assignment:\n");
    assignOrder();
    assignOrder();
    assignOrder();

    generateReport();

    return 0;
}
