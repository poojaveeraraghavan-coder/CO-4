
#include <stdio.h>
#include <string.h>

#define N 10

long long comparisons;

void copyArray(int source[], int destination[]) {
    for (int i = 0; i < N; i++)
        destination[i] = source[i];
}

void printArray(int a[]) {
    for (int i = 0; i < N; i++)
        printf("%d ", a[i]);
    printf("\n");
}

void bubbleSort(int a[]) {
    comparisons = 0;
    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - i - 1; j++) {
            comparisons++;
            if (a[j] > a[j + 1]) {
                int t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
        }
    }
}

void insertionSort(int a[]) {
    comparisons = 0;
    for (int i = 1; i < N; i++) {
        int key = a[i];
        int j = i - 1;

        while (j >= 0) {
            comparisons++;
            if (a[j] > key) {
                a[j + 1] = a[j];
                j--;
            } else {
                break;
            }
        }
        a[j + 1] = key;
    }
}

void selectionSort(int a[]) {
    comparisons = 0;
    for (int i = 0; i < N - 1; i++) {
        int min = i;
        for (int j = i + 1; j < N; j++) {
            comparisons++;
            if (a[j] < a[min])
                min = j;
        }

        int t = a[i];
        a[i] = a[min];
        a[min] = t;
    }
}

void merge(int a[], int left, int mid, int right) {
    int temp[N];
    int i = left, j = mid + 1, k = left;

    while (i <= mid && j <= right) {
        comparisons++;
        if (a[i] <= a[j])
            temp[k++] = a[i++];
        else
            temp[k++] = a[j++];
    }

    while (i <= mid)
        temp[k++] = a[i++];

    while (j <= right)
        temp[k++] = a[j++];

    for (i = left; i <= right; i++)
        a[i] = temp[i];
}

void mergeSort(int a[], int left, int right) {
    if (left < right) {
        int mid = left + (right - left) / 2;
        mergeSort(a, left, mid);
        mergeSort(a, mid + 1, right);
        merge(a, left, mid, right);
    }
}

int partition(int a[], int low, int high) {
    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        comparisons++;
        if (a[j] <= pivot) {
            i++;
            int t = a[i];
            a[i] = a[j];
            a[j] = t;
        }
    }

    int t = a[i + 1];
    a[i + 1] = a[high];
    a[high] = t;

    return i + 1;
}

void quickSort(int a[], int low, int high) {
    if (low < high) {
        int p = partition(a, low, high);
        quickSort(a, low, p - 1);
        quickSort(a, p + 1, high);
    }
}

int main(void) {
    int original[N] = {78, 45, 90, 32, 67, 23, 88, 56, 12, 70};
    int a[N];

    printf("Original Array:\n");
    printArray(original);

    copyArray(original, a);
    bubbleSort(a);
    printf("\nBubble Sort: ");
    printArray(a);
    printf("Comparisons: %lld\n", comparisons);

    copyArray(original, a);
    insertionSort(a);
    printf("\nInsertion Sort: ");
    printArray(a);
    printf("Comparisons: %lld\n", comparisons);

    copyArray(original, a);
    selectionSort(a);
    printf("\nSelection Sort: ");
    printArray(a);
    printf("Comparisons: %lld\n", comparisons);

    copyArray(original, a);
    comparisons = 0;
    mergeSort(a, 0, N - 1);
    printf("\nMerge Sort: ");
    printArray(a);
    printf("Comparisons: %lld\n", comparisons);

    copyArray(original, a);
    comparisons = 0;
    quickSort(a, 0, N - 1);
    printf("\nQuick Sort: ");
    printArray(a);
    printf("Comparisons: %lld\n", comparisons);

    return 0;
}
