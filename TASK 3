
#include <stdio.h>

#define MAX 32

typedef struct {
    int severity;
    int patient;
} Case;

Case heap[MAX];
int size = 0;

void swap(Case *a, Case *b)
{
    Case t = *a;
    *a = *b;
    *b = t;
}

void push(int severity, int patient)
{
    if (size == MAX)
        return;

    heap[size] = (Case){severity, patient};

    int i = size++;

    /* TODO 1: Sift up */
    while (i > 0)
    {
        int parent = (i - 1) / 2;

        if (heap[parent].severity >= heap[i].severity)
            break;

        swap(&heap[parent], &heap[i]);
        i = parent;
    }
}

Case pop(void)
{
    Case top = heap[0];

    heap[0] = heap[--size];

    int i = 0;

    /* TODO 2: Sift down */
    while (1)
    {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int largest = i;

        if (left < size &&
            heap[left].severity > heap[largest].severity)
            largest = left;

        if (right < size &&
            heap[right].severity > heap[largest].severity)
            largest = right;

        if (largest == i)
            break;

        swap(&heap[i], &heap[largest]);
        i = largest;
    }

    return top;
}

int main(void)
{
    push(3, 101);
    push(9, 102);
    push(5, 103);
    push(7, 104);
    push(1, 105);
    push(8, 106);

    printf("Patient treatment order:\n");

    while (size > 0)
    {
        Case p = pop();
        printf("P%d(%d) ", p.patient, p.severity);
    }

    printf("\n");

    return 0;
}




#include <stdio.h>

void sift_down(int a[], int n, int i)
{
    for (;;)
    {
        int l = 2 * i + 1;
        int r = l + 1;
        int s = i;

        if (l < n && a[l] < a[s])
            s = l;

        if (r < n && a[r] < a[s])
            s = r;

        if (s == i)
            return;

        int t = a[i];
        a[i] = a[s];
        a[s] = t;

        i = s;
    }
}

int main(void)
{
    int a[] = {9, 4, 7, 1, 8, 2, 6};
    int n = 7;

    for (int i = n / 2 - 1; i >= 0; i--)
    {
        sift_down(a, n, i);

        printf("After sift_down(%d): ", i);

        for (int j = 0; j < n; j++)
            printf("%d ", a[j]);

        printf("\n");
    }

    printf("Final Min Heap: ");

    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\n");

    return 0;
}

